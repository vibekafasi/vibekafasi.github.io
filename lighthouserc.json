{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "numberOfRuns": 1,
      "url": [
        "http://localhost/index.html",
        "http://localhost/ru/index.html",
        "http://localhost/en/index.html",
        "http://localhost/akademi/index.html",
        "http://localhost/akademi/ilk-gun/index.html",
        "http://localhost/akademi/git-nedir/index.html",
        "http://localhost/akademi/sozluk/index.html",
        "http://localhost/akademi/sozluk/api/index.html",
        "http://localhost/akademi/videolar/index.html",
        "http://localhost/akademi/mezuniyet/index.html",
        "http://localhost/kilavuz/index.html",
        "http://localhost/kafa/index.html",
        "http://localhost/404.html"
      ],
      "settings": {"chromeFlags": "--no-sandbox --headless=new"}
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.9, "aggregationMethod": "median-run"}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["error", {"minScore": 0.95}],
        "categories:seo": ["error", {"minScore": 0.95}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": ".lighthouseci"}
  }
}
